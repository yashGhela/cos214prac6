# Doxyfile for TIVIDY. Generate the docs with:  make docs   (or: doxygen Doxyfile)
PROJECT_NAME = "TIVIDY Workflow Engine"
PROJECT_BRIEF = "Workflow management system built from GoF design patterns"
OUTPUT_DIRECTORY = docs
INPUT = include src ../README.md
FILE_PATTERNS = *.h *.cpp *.md
RECURSIVE = NO
USE_MDFILE_AS_MAINPAGE = ../README.md
EXTRACT_ALL = YES
EXTRACT_PRIVATE = YES
EXTRACT_STATIC = YES
JAVADOC_AUTOBRIEF = NO
OPTIMIZE_OUTPUT_FOR_C = NO
SOURCE_BROWSER = YES
GENERATE_HTML = YES
GENERATE_LATEX = NO
HAVE_DOT = NO
CLASS_GRAPH = YES
COLLABORATION_GRAPH = YES
UML_LOOK = YES
CALL_GRAPH = NO
QUIET = YES
WARN_IF_UNDOCUMENTED = YES
WARN_NO_PARAMDOC = YES
